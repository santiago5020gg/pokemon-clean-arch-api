# Base URL the frontend uses to reach the backend API.
# Dev (Vite proxy handles CORS): keep the relative `/api`.
# Docker / prod: set the absolute backend URL, e.g. http://backend:8080/api
VITE_API_BASE_URL=/api

# Optional: override the dev proxy target (defaults to http://localhost:8080)
# VITE_API_PROXY_TARGET=http://localhost:8080
